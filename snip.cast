[0.000, "o", "4;1H\u001b[38;2;224;222;244;49m}\u001b[26;1H\u001b[38;2;156;207;216;49mconst\u001b[38;2;224;222;244;49m \u001b[3mnames\u001b[23m \u001b[38;2;140;136;166;49m=\u001b[38;2;224;222;244;49m \u001b[3mlogsDB\u001b[23m\u001b[38;2;140;136;166;49m.\u001b[3m\u001b[38;2;224;222;244;49mgetCollectionNames\u001b[23m()\u001b[38;2;140;136;166;49m;\u001b[28;1H\u001b[38;2;156;207;216;49mconst\u001b[38;2;224;222;244;49m \u001b[3mstatsList\u001b[23m \u001b[38;2;140;136;166;49m=\u001b[38;2;224;222;244;49m \u001b[3mnames\u001b[23m\u001b[38;2;140;136;166;49m.\u001b[3m\u001b[38;2;224;222;244;49mmap\u001b[23m(\u001b[38;2;140;136;166;49m(\u001b[3m\u001b[38;2;196;167;231;49mname\u001b[23m\u001b[38;2;140;136;166;49m)\u001b[38;2;224;222;244;49m \u001b[38;2;156;207;216;49m=>\u001b[38;2;224;222;244;49m {\u001b[29;1H  \u001b[38;2;49;116;143;49mtry\u001b[38;2;224;222;244;49m {\u001b[30;1H    \u001b[38;2;156;207;216;49mconst\u001b[38;2;224;222;244;49m \u001b[3ms\u001b[23m \u001b[38;2;140;136;166;49m=\u001b[38;2;224;222;244;49m \u001b[3mlogsDB\u001b[23m\u001b[38;2;140;136;166;49m.\u001b[3m\u001b[38;2;224;222;244;49mgetCollection\u001b[23m(\u001b[3mname\u001b[23m)\u001b[38;2;140;136;166;49m.\u001b[3m\u001b[38;2;224;222;244;49mstats\u001b[23m()\u001b[38;2;140;136;166;49m;\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[1;11H"]
