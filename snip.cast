[0.249, "o", "\u001b[2;148H\u001b[38;2;140;136;166;49m3\u001b[5;1H\u001b[1m\u001b[38;2;235;188;186;49m \u001b[5;3H\u001b[22m\u001b[39;49maws/s3-\u001b[38;2;156;207;216;48;5;0ml\u001b[39;49mi\u001b[38;2;156;207;216;48;5;0ms\u001b[39;49mt-in-bucket.nu\u001b[6;1H\u001b[1m\u001b[38;2;235;188;186;49m>\u001b[6;3H\u001b[22m\u001b[38;2;224;222;244;48;2;38;35;58mconnection-string/convert-mole-config-to-sq\u001b[1m\u001b[38;2;235;188;186;48;5;236mls\u001b[22m\u001b[38;2;224;222;244;48;2;38;35;58m.nu\u001b[10;1H\u001b[38;2;224;222;244;49m# Convert mole's connections.yaml into an sqls language-server config.yml.\u001b[11;1H#\u001b[39;49m                                                                                 \u001b[12;1H\u001b[38;2;224;222;244;49m# Reproduces the old `mole cfg translate-to sqls` for the NEW source-keyed config\u001b[13;1H# at `~/.config/mole/connections.yaml` (honors $XDG_CONFIG_HOME): connections are\u001b[14;1H# a `connections:` map keyed by SOURCE, one section per submodule. Only the SQL\u001b[15;1H# sources sqls actually speaks are emitted — psql -> postgresql, mysql -> mysql;\u001b[16;1H# every other source (duckdb, trino, victorialogs, ...) is skipped. Engine"]
[0.000, "o", "\u001b[17;1H# variants within a source (timescaledb, yugabytedb, mariadb, percona, ...) all\u001b[18;1H# fold onto the same sqls driver, so we map on the section key, not on `driver`.\u001b[19;1H#\u001b[20;1H# Usage:\u001b[21;1H#   nu convert-mole-config-to-sqls.nu            # writes <config>/sqls/config.yml\u001b[22;1H#   nu convert-mole-config-to-sqls.nu --dry-run  # prints the yaml instead\u001b[24;1Hdef convert-mole-config-to-sqls [--dry-run] {\u001b[25;1H  # source (section key) -> sqls driver name; the keys double as the allow-list.\u001b[26;1H  let source_driver = { psql: \"postgresql\", mysql: \"mysql\" }\u001b[27;1H  # per-source default port, used when a record omits `port`.\u001b[28;1H  let default_port = { psql: 5432, mysql: 3306 }\u001b[30;1H  let base = $env.XDG_CONFIG_HOME? | default ([$nu.home-dir .config] | path join)\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[1;11H"]
